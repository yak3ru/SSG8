{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SSG8: Run Desktop App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/ssg8/main.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
